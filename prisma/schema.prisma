generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id             String   @id @default(uuid())
  name           String
  slug           String?  @unique
  isActive       Boolean  @default(true)
  settings       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  operators         Operator[]
  leads             Lead[]
  conversations     Conversation[]
  messages          Message[]
  paymentOrders     PaymentOrder[]
  shipments         Shipment[]
  carriers          Carrier[]
  campaigns         Campaign[]
  products          Product[]
  liveSessions      LiveSession[]
  messageTemplates  MessageTemplate[]
  botConfigs        BotConfig[]
  activityLogs      ActivityLog[]

  @@index([slug])
  @@index([isActive])
}

model Lead {
  id                String    @id @default(uuid())
  orgId             String?
  organization      Organization? @relation(fields: [orgId], references: [id])
  phone             String    @unique
  name              String?
  source            String?
  internalNotes     String?
  addressStreet     String?
  addressNumber     String?
  addressColonia    String?
  addressCity       String?
  addressState      String?
  addressZipCode    String?
  addressNotes      String?
  firstContactAt    DateTime  @default(now())
  lastInteractionAt DateTime?
  metadata          Json?

  conversations     Conversation[]
  paymentOrders     PaymentOrder[]
  shipments         Shipment[]
  campaignRecipients CampaignRecipient[]

  @@index([phone])
  @@index([lastInteractionAt])
  @@index([orgId])
}

model Conversation {
  id               String            @id @default(uuid())
  orgId            String?
  organization     Organization?      @relation(fields: [orgId], references: [id])
  leadId           String
  lead             Lead              @relation(fields: [leadId], references: [id])
  status           ConversationStatus @default(NEW)
  priority         Int               @default(0)
  assignedToId     String?
  assignedTo       Operator?         @relation(fields: [assignedToId], references: [id])
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  lastMessageAt    DateTime?
  closedAt         DateTime?
  firstResponseAt  DateTime?
  responseTimeMs  Int?

  messages         Message[]
  paymentOrders    PaymentOrder[]

  @@index([status])
  @@index([assignedToId])
  @@index([leadId])
  @@index([lastMessageAt])
  @@index([orgId])
}

enum ConversationStatus {
  NEW
  ATTENTION
  AWAITING_PAYMENT
  PAID
  SHIPPED
  CLOSED
  LOST
}

model Message {
  id             String    @id @default(uuid())
  orgId          String?
  organization   Organization? @relation(fields: [orgId], references: [id])
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  direction      Direction
  type           MessageType @default(TEXT)
  content        String?
  mediaUrl       String?
  mediaType      String?
  whatsappMsgId  String?
  fromPhone      String?
  sentAt         DateTime  @default(now())
  deliveredAt    DateTime?
  readAt         DateTime?
  isTemplate     Boolean   @default(false)
  templateId     String?

  @@index([conversationId])
  @@index([whatsappMsgId])
  @@index([sentAt])
  @@index([orgId])
}

enum Direction {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  LOCATION
  PAYMENT_LINK
  SYSTEM
}

model PaymentOrder {
  id              String        @id @default(uuid())
  orgId           String?
  organization    Organization?  @relation(fields: [orgId], references: [id])
  conversationId  String
  conversation    Conversation  @relation(fields: [conversationId], references: [id])
  leadId          String
  lead            Lead          @relation(fields: [leadId], references: [id])
  liveSessionId   String?
  liveSession     LiveSession?  @relation(fields: [liveSessionId], references: [id])
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("MXN")
  concept         String
  status          PaymentStatus @default(PENDING)
  provider        PaymentProvider?
  providerLinkId  String?
  providerLinkUrl String?
  createdById     String?
  createdBy       Operator?     @relation("CreatedPayments", fields: [createdById], references: [id])
  createdAt       DateTime      @default(now())
  sentAt          DateTime?
  paidAt          DateTime?
  expiresAt       DateTime?
  metadata        Json?
  shipment        Shipment?

  @@index([status])
  @@index([conversationId])
  @@index([leadId])
  @@index([liveSessionId])
  @@index([createdById])
  @@index([paidAt])
  @@index([orgId])
}

model LiveSession {
  id          String         @id @default(uuid())
  orgId       String?
  organization Organization? @relation(fields: [orgId], references: [id])
  title       String
  platform    String         @default("TIKTOK")
  status      String         @default("ACTIVE")
  startedAt   DateTime       @default(now())
  endedAt     DateTime?
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  paymentOrders PaymentOrder[]

  @@index([status])
  @@index([startedAt])
  @@index([orgId])
}

enum PaymentStatus {
  PENDING
  SENT
  PAID
  EXPIRED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  MERCADOPAGO
  STRIPE
  PAYPAL
  CASH
  TRANSFER
}

model Operator {
  id                String    @id @default(uuid())
  orgId             String?
  organization      Organization? @relation(fields: [orgId], references: [id])
  name              String
  email             String    @unique
  passwordHash      String?
  role              OperatorRole @default(AGENT)
  isActive          Boolean   @default(true)
  maxConversations  Int       @default(10)
  currentLoad       Int       @default(0)
  isOnline          Boolean   @default(false)
  lastSeenAt        DateTime?
  avatarUrl         String?
  createdAt         DateTime  @default(now())

  assignedConversations Conversation[]
  createdPayments   PaymentOrder[] @relation("CreatedPayments")

  @@index([isOnline])
  @@index([role])
  @@index([orgId])
}

enum OperatorRole {
  ADMIN
  AGENT
  VIEWER
}

model MessageTemplate {
  id          String    @id @default(uuid())
  orgId       String?
  organization Organization? @relation(fields: [orgId], references: [id])
  name        String
  content     String
  category    String
  shortcut    String?
  variables   String[]
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([orgId])
}

model BotConfig {
  id                String    @id @default(uuid())
  orgId             String?
  organization      Organization? @relation(fields: [orgId], references: [id])
  name              String    @default("default")
  welcomeMessage    String
  awayMessage       String?
  queueMessage      String?
  autoReplyEnabled  Boolean   @default(true)
  autoReplyDelayMs  Int       @default(1000)
  businessHoursStart String?
  businessHoursEnd   String?
  timezone          String    @default("America/Mexico_City")
  updatedAt         DateTime  @updatedAt

  @@index([orgId])
}

model ActivityLog {
  id             String    @id @default(uuid())
  orgId          String?
  organization   Organization? @relation(fields: [orgId], references: [id])
  operatorId     String?
  conversationId String?
  action         String
  details        Json?
  createdAt      DateTime  @default(now())

  @@index([conversationId])
  @@index([operatorId])
  @@index([createdAt])
  @@index([orgId])
}

model Product {
  id          String    @id @default(uuid())
  orgId       String?
  organization Organization? @relation(fields: [orgId], references: [id])
  name        String
  description String?
  price       Decimal   @db.Decimal(10, 2)
  currency    String    @default("MXN")
  imageUrl    String?
  category    String?
  stock       Int       @default(10)
  isActive    Boolean   @default(true)
  isAvailable Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive])
  @@index([isAvailable])
  @@index([category])
  @@index([orgId])
}

enum CarrierMode {
  COURIER
  EXTERNAL_OWN_FLEET
  STORE_PICKUP
}

enum CarrierApiProvider {
  MANUAL
  CHILEXPRESS
  BLUE
  SHIPIT
  ENVIAME
  STARKEN
  CORREOS
  SIMPLIROUTE
  BEETRACK
}

enum ShipmentMode {
  COURIER
  OWN_FLEET
  PICKUP
}

enum EventSource {
  MANUAL
  API
  WEBHOOK
}

model Carrier {
  id         String            @id @default(uuid())
  orgId      String
  organization Organization @relation(fields: [orgId], references: [id])
  code       String
  name       String
  mode       CarrierMode
  apiProvider CarrierApiProvider @default(MANUAL)
  active     Boolean           @default(true)
  config     Json?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  shipments  Shipment[]

  @@unique([orgId, code])
  @@index([active])
  @@index([mode])
}

model Shipment {
  id             String         @id @default(uuid())
  orgId          String?
  organization   Organization?   @relation(fields: [orgId], references: [id])
  paymentOrderId String         @unique
  paymentOrder   PaymentOrder   @relation(fields: [paymentOrderId], references: [id])
  leadId         String
  lead           Lead           @relation(fields: [leadId], references: [id])
  trackingNumber String?
  carrier        String?
  mode           ShipmentMode?
  carrierId      String?
  carrierRef     Carrier?       @relation(fields: [carrierId], references: [id])
  service        String?
  weightGrams    Int?
  dimensions     Json?
  costClp        Int?
  labelUrl       String?
  trackingUrl    String?
  providerRef    String?
  recipient      Json?
  address        Json?
  driverId       String?
  attempts       Int            @default(0)
  deliveredTo    String?
  proofPhotoUrl  String?
  status         ShipmentStatus @default(PENDING)
  shippedAt      DateTime?
  deliveredAt    DateTime?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  events         ShipmentEvent[]

  @@index([status])
  @@index([leadId])
  @@index([paymentOrderId])
  @@index([mode])
  @@index([carrierId])
  @@index([orgId])
}

model ShipmentEvent {
  id         String         @id @default(uuid())
  shipmentId String
  shipment   Shipment       @relation(fields: [shipmentId], references: [id])
  status     ShipmentStatus
  occurredAt DateTime       @default(now())
  source     EventSource    @default(MANUAL)
  note       String?
  payload    Json?

  @@index([shipmentId])
  @@index([occurredAt])
}

enum ShipmentStatus {
  PENDING
  READY
  LABEL_PRINTED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
  LOST
  CANCELLED
}

model Campaign {
  id          String    @id @default(uuid())
  orgId       String?
  organization Organization? @relation(fields: [orgId], references: [id])
  name        String
  message     String
  status      CampaignStatus @default(DRAFT)
  scheduledAt DateTime?
  sentAt      DateTime?
  totalLeads  Int       @default(0)
  sentCount   Int       @default(0)
  failedCount Int       @default(0)
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  recipients  CampaignRecipient[]

  @@index([status])
  @@index([scheduledAt])
  @@index([orgId])
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED
}

model CampaignRecipient {
  id         String    @id @default(uuid())
  campaignId String
  campaign   Campaign  @relation(fields: [campaignId], references: [id])
  leadId     String
  lead       Lead      @relation(fields: [leadId], references: [id])
  status     RecipientStatus @default(PENDING)
  sentAt     DateTime?
  deliveredAt DateTime?
  readAt     DateTime?
  errorMessage String?
  createdAt  DateTime  @default(now())

  @@index([campaignId])
  @@index([leadId])
  @@index([status])
}

enum RecipientStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}



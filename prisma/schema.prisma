generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id                String    @id @default(uuid())
  phone             String    @unique
  name              String?
  source            String?
  internalNotes     String?
  addressStreet     String?
  addressNumber     String?
  addressColonia    String?
  addressCity       String?
  addressState      String?
  addressZipCode    String?
  addressNotes      String?
  firstContactAt    DateTime  @default(now())
  lastInteractionAt DateTime?
  metadata          Json?

  conversations     Conversation[]
  paymentOrders     PaymentOrder[]
  shipments         Shipment[]
  campaignRecipients CampaignRecipient[]

  @@index([phone])
  @@index([lastInteractionAt])
}

model Conversation {
  id               String            @id @default(uuid())
  leadId           String
  lead             Lead              @relation(fields: [leadId], references: [id])
  status           ConversationStatus @default(NEW)
  priority         Int               @default(0)
  assignedToId     String?
  assignedTo       Operator?         @relation(fields: [assignedToId], references: [id])
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  lastMessageAt    DateTime?
  closedAt         DateTime?
  firstResponseAt  DateTime?
  responseTimeMs  Int?

  messages         Message[]
  paymentOrders    PaymentOrder[]

  @@index([status])
  @@index([assignedToId])
  @@index([leadId])
  @@index([lastMessageAt])
}

enum ConversationStatus {
  NEW
  ATTENTION
  AWAITING_PAYMENT
  PAID
  SHIPPED
  CLOSED
  LOST
}

model Message {
  id             String    @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  direction      Direction
  type           MessageType @default(TEXT)
  content        String?
  mediaUrl       String?
  mediaType      String?
  whatsappMsgId  String?
  fromPhone      String?
  sentAt         DateTime  @default(now())
  deliveredAt    DateTime?
  readAt         DateTime?
  isTemplate     Boolean   @default(false)
  templateId     String?

  @@index([conversationId])
  @@index([whatsappMsgId])
  @@index([sentAt])
}

enum Direction {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  LOCATION
  PAYMENT_LINK
  SYSTEM
}

model PaymentOrder {
  id              String        @id @default(uuid())
  conversationId  String
  conversation    Conversation  @relation(fields: [conversationId], references: [id])
  leadId          String
  lead            Lead          @relation(fields: [leadId], references: [id])
  liveSessionId   String?
  liveSession     LiveSession?  @relation(fields: [liveSessionId], references: [id])
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("MXN")
  concept         String
  status          PaymentStatus @default(PENDING)
  provider        PaymentProvider?
  providerLinkId  String?
  providerLinkUrl String?
  createdById     String?
  createdBy       Operator?     @relation("CreatedPayments", fields: [createdById], references: [id])
  createdAt       DateTime      @default(now())
  sentAt          DateTime?
  paidAt          DateTime?
  expiresAt       DateTime?
  metadata        Json?
  shipment        Shipment?

  @@index([status])
  @@index([conversationId])
  @@index([leadId])
  @@index([liveSessionId])
  @@index([createdById])
  @@index([paidAt])
}

model LiveSession {
  id          String         @id @default(uuid())
  title       String
  platform    String         @default("TIKTOK")
  status      String         @default("ACTIVE")
  startedAt   DateTime       @default(now())
  endedAt     DateTime?
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  paymentOrders PaymentOrder[]

  @@index([status])
  @@index([startedAt])
}

enum PaymentStatus {
  PENDING
  SENT
  PAID
  EXPIRED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  MERCADOPAGO
  STRIPE
  PAYPAL
  CASH
  TRANSFER
}

model Operator {
  id                String    @id @default(uuid())
  name              String
  email             String    @unique
  passwordHash      String?
  role              OperatorRole @default(AGENT)
  isActive          Boolean   @default(true)
  maxConversations  Int       @default(10)
  currentLoad       Int       @default(0)
  isOnline          Boolean   @default(false)
  lastSeenAt        DateTime?
  avatarUrl         String?
  createdAt         DateTime  @default(now())

  assignedConversations Conversation[]
  createdPayments   PaymentOrder[] @relation("CreatedPayments")

  @@index([isOnline])
  @@index([role])
}

enum OperatorRole {
  ADMIN
  AGENT
  VIEWER
}

model MessageTemplate {
  id          String    @id @default(uuid())
  name        String
  content     String
  category    String
  shortcut    String?
  variables   String[]
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model BotConfig {
  id                String    @id @default(uuid())
  name              String    @default("default")
  welcomeMessage    String
  awayMessage       String?
  queueMessage      String?
  autoReplyEnabled  Boolean   @default(true)
  autoReplyDelayMs  Int       @default(1000)
  businessHoursStart String?
  businessHoursEnd   String?
  timezone          String    @default("America/Mexico_City")
  updatedAt         DateTime  @updatedAt
}

model ActivityLog {
  id             String    @id @default(uuid())
  operatorId     String?
  conversationId String?
  action         String
  details        Json?
  createdAt      DateTime  @default(now())

  @@index([conversationId])
  @@index([operatorId])
  @@index([createdAt])
}

model Product {
  id          String    @id @default(uuid())
  name        String
  description String?
  price       Decimal   @db.Decimal(10, 2)
  currency    String    @default("MXN")
  imageUrl    String?
  category    String?
  stock       Int       @default(10)
  isActive    Boolean   @default(true)
  isAvailable Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive])
  @@index([isAvailable])
  @@index([category])
}

model Shipment {
  id               String    @id @default(uuid())
  paymentOrderId   String    @unique
  paymentOrder     PaymentOrder @relation(fields: [paymentOrderId], references: [id])
  leadId           String
  lead             Lead      @relation(fields: [leadId], references: [id])
  trackingNumber   String?
  carrier          String?
  status           ShipmentStatus @default(PENDING)
  shippedAt        DateTime?
  deliveredAt      DateTime?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@index([leadId])
  @@index([paymentOrderId])
}

enum ShipmentStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
  RETURNED
  LOST
}

model Campaign {
  id          String    @id @default(uuid())
  name        String
  message     String
  status      CampaignStatus @default(DRAFT)
  scheduledAt DateTime?
  sentAt      DateTime?
  totalLeads  Int       @default(0)
  sentCount   Int       @default(0)
  failedCount Int       @default(0)
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  recipients  CampaignRecipient[]

  @@index([status])
  @@index([scheduledAt])
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED
}

model CampaignRecipient {
  id         String    @id @default(uuid())
  campaignId String
  campaign   Campaign  @relation(fields: [campaignId], references: [id])
  leadId     String
  lead       Lead      @relation(fields: [leadId], references: [id])
  status     RecipientStatus @default(PENDING)
  sentAt     DateTime?
  deliveredAt DateTime?
  readAt     DateTime?
  errorMessage String?
  createdAt  DateTime  @default(now())

  @@index([campaignId])
  @@index([leadId])
  @@index([status])
}

enum RecipientStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

model BusinessConfig {
  id                    String    @id @default(uuid())
  businessName          String
  currency              String    @default("MXN")
  timezone              String    @default("America/Mexico_City")
  bankName              String?
  bankBeneficiary       String?
  bankAccountNumber     String?
  bankClabe             String?
  bankNotes             String?
  soundAlertsEnabled    Boolean   @default(false)
  autoExpireOrders      Boolean   @default(true)
  orderExpirationMinutes Int      @default(30)
  autoReleaseStock      Boolean   @default(true)
  businessHoursStart    String?
  businessHoursEnd      String?
  autoReplyEnabled      Boolean   @default(true)
  autoReplyDelayMs      Int       @default(1000)
  welcomeMessage        String
  awayMessage           String?
  queueMessage          String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

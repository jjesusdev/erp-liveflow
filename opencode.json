{
  "$schema": "https://opencode.ai/config.json",
  "skills": ["./.opencode/skills"],
  "formatter": true,
  "permissions": [
    { "action": "shell", "resource": "npm *", "effect": "allow" },
    { "action": "shell", "resource": "npx prisma *", "effect": "allow" },
    { "action": "shell", "resource": "npx tsc *", "effect": "allow" },
    { "action": "shell", "resource": "npx eslint *", "effect": "allow" },
    { "action": "shell", "resource": "npx prettier *", "effect": "allow" },
    { "action": "shell", "resource": "npx vitest *", "effect": "allow" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git add *", "effect": "allow" },
    { "action": "shell", "resource": "git commit *", "effect": "allow" },
    { "action": "shell", "resource": "git branch *", "effect": "allow" },
    { "action": "shell", "resource": "git fetch *", "effect": "allow" },
    { "action": "shell", "resource": "git switch *", "effect": "allow" },
    { "action": "shell", "resource": "git restore *", "effect": "allow" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "git push --force*", "effect": "deny" },
    { "action": "shell", "resource": "git reset --hard*", "effect": "ask" },
    { "action": "shell", "resource": "rm -rf /*", "effect": "deny" },
    { "action": "shell", "resource": "docker *", "effect": "allow" },
    { "action": "shell", "resource": "docker compose *", "effect": "allow" },
    { "action": "shell", "resource": "psql *", "effect": "ask" }
  ]
}

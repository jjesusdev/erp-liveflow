# Database (alineado con docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/liveflow_db?schema=public"

# MercadoPago
MP_ACCESS_TOKEN="TEST-xxx"
MP_PUBLIC_KEY="TEST-xxx"

# Stripe (alternativa)
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# Cloudinary (para imágenes de WhatsApp)
CLOUDINARY_CLOUD_NAME="your-cloud"
CLOUDINARY_API_KEY="xxx"
CLOUDINARY_API_SECRET="xxx"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
PORT=3001
DISABLE_WHATSAPP=true
DISABLE_WORKERS=true
HOSTNAME=0.0.0.0

# Sesión de operadores (requerido para auth)
SESSION_SECRET="cambia-esta-clave-secreta-en-produccion-minimo-32-caracteres"

# Notas de inicialización:
# - Para crear usuarios demo, ejecuta: npm run init-demo
# - Para local: npm run db:seed
# - Para Render/Vercel: el login crea usuarios demo automáticamente si no existen

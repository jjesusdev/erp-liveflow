# Database (alineado con docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/liveflow_db?schema=public"

# MercadoPago
MP_ACCESS_TOKEN="TEST-xxx"
MP_PUBLIC_KEY="TEST-xxx"
# Obligatorio en producción: verify_xsignature del webhook (HMAC-SHA256)
MP_WEBHOOK_SECRET=""

# Stripe (alternativa)
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# Cloudinary (para imágenes de WhatsApp)
CLOUDINARY_CLOUD_NAME="your-cloud"
CLOUDINARY_API_KEY="xxx"
CLOUDINARY_API_SECRET="xxx"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3001"
NODE_ENV="development"
PORT=3001
DISABLE_WHATSAPP=true
DISABLE_WORKERS=true
HOSTNAME=0.0.0.0

# Sesión de operadores (requerido para auth)
SESSION_SECRET="cambia-esta-clave-secreta-en-produccion-minimo-32-caracteres"

# Seguridad
# Orígenes permitidos para Socket.IO (separados por coma). En producción, lista explícita.
ALLOWED_ORIGINS="http://localhost:3001"
# Sólo habilita el login demo en producción si es un entorno de revisión: "true"
ALLOW_DEMO_LOGIN="false"

# Notas de inicialización:
# - Para crear usuarios demo, ejecuta: npm run db:seed
# - En producción usa operadores reales; el login demo está deshabilitado por defecto.
# - Ejecuta `npm run db:deploy` antes de arrancar el servidor (prisma migrate deploy).

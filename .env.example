# Database (alineado con docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/liveflow_db?schema=public"

# MercadoPago
MP_ACCESS_TOKEN="TEST-xxx"
MP_PUBLIC_KEY="TEST-xxx"

# Stripe (alternativa)
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# Cloudinary (para imágenes de WhatsApp)
CLOUDINARY_CLOUD_NAME="your-cloud"
CLOUDINARY_API_KEY="xxx"
CLOUDINARY_API_SECRET="xxx"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Carriers (credenciales por proveedor; no hardcodear en código).
# Se prioriza la config guardada en cada Carrier (campo config) y se usa
# estas variables como fallback. SHIPIT es el primer provider con HTTP real.
SHIPIT_API_KEY=""
SHIPIT_API_SECRET=""
SHIPIT_BASE_URL="https://api.shipit.cl"
